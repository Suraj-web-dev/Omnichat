# Server Port & Database
PORT=5000
MONGODB_URI=mongodb://localhost:27017/omnichat

# ==========================================
# 🌟 FREE AI API KEYS (Recommended)
# ==========================================

# 1. Google Gemini API (100% FREE - No credit card needed)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Cohere API (FREE Tier - Command R / Command R+)
# Get key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus

# 3. Groq Cloud API (100% FREE & Ultra Fast - Llama 3.3 70B)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 💳 OPTIONAL PAID API
# ==========================================
# OpenAI API (Optional - for GPT-4o / GPT-4o-mini)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
